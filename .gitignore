# ==============================================================================
# 🎯 Complete .gitignore for LeetCode C / C++ / Python Repository
# ==============================================================================

# ------------------------------------------------------------------------------
# 💻 C & C++ Compiled Binaries and Objects
# ------------------------------------------------------------------------------
*.o
*.obj
*.slo
*.lo
*.d

# Precompiled Headers
*.gch
*.pch

# Static Libraries
*.a
*.lib
*.la
*.lai

# Shared / Dynamic Libraries
*.so
*.so.*
*.dylib
*.dll

# Executables & Binaries
*.exe
*.out
*.app
*.bin
*.elf
*.hex
a.out
solution
test

# Debugging Artifacts & Symbol Stores
*.dSYM/
*.su
*.idb
*.pdb
*.ilk

# Code Coverage & Profiling
*.gcno
*.gcda
*.gcov
gmon.out

# ------------------------------------------------------------------------------
# 🛠️ Build Systems (CMake / Make)
# ------------------------------------------------------------------------------
build/
bin/
out/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile.in

# ------------------------------------------------------------------------------
# 🐍 Python (for helper scripts & auto-updater)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 🧰 IDEs & Text Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / CLion / PyCharm
.idea/
*.iml

# Visual Studio
.vs/
*.vcxproj*
*.sln.docstates
*.user
*.suo

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*~
*.swp
*.swo
*.swn
.#*
\#*\#

# ------------------------------------------------------------------------------
# 🖥️ Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.directory
.Trash-*
.fuse_hidden*

# ------------------------------------------------------------------------------
# 📝 Temporary & Log Files
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
